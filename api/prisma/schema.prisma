generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  notebooks Notebook[]
  notes     Note[]
  tags      Tag[]

  @@map("users")
}

/// Notebooks nest one level deep: a notebook either has no parent or its
/// parent is a top-level notebook. The service enforces this.
model Notebook {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Notebook?  @relation("NotebookChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children Notebook[] @relation("NotebookChildren")
  notes    Note[]

  @@index([userId])
  @@index([parentId])
  @@map("notebooks")
}

model Note {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  notebookId String?   @map("notebook_id") @db.Uuid
  title      String
  content    String    @default("")
  pinned     Boolean   @default(false)
  favorite   Boolean   @default(false)
  /// Set when the note is moved to the trash.
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  /// Only bumped when the title, content, notebook or tags change, so
  /// pinning a note does not move it to the top of "recently edited".
  updatedAt  DateTime  @default(now()) @map("updated_at")

  /// Kept up to date by a trigger (see the search migration), queried with raw SQL.
  searchVector Unsupported("tsvector")? @map("search_vector")

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  notebook      Notebook?     @relation(fields: [notebookId], references: [id], onDelete: SetNull)
  tags          NoteTag[]
  outgoingLinks NoteLink[]
  versions      NoteVersion[]
  share         ShareLink?

  @@index([userId, deletedAt, updatedAt])
  @@index([searchVector], type: Gin)
  @@index([notebookId])
  @@map("notes")
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes NoteTag[]

  @@unique([userId, name])
  @@map("tags")
}

model NoteTag {
  noteId String @map("note_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@index([tagId])
  @@map("note_tags")
}

/// A [[wiki link]] written in a note. Links point at a title rather than an
/// id, so they resolve to whichever note currently has that title.
model NoteLink {
  id          String @id @default(uuid()) @db.Uuid
  sourceId    String @map("source_id") @db.Uuid
  /// The title as written in the link.
  targetTitle String @map("target_title")
  /// Lower-cased, whitespace-collapsed title used for matching.
  targetKey   String @map("target_key")

  source Note @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetKey])
  @@index([targetKey])
  @@map("note_links")
}

model NoteVersion {
  id        String   @id @default(uuid()) @db.Uuid
  noteId    String   @map("note_id") @db.Uuid
  title     String
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, createdAt])
  @@map("note_versions")
}

model ShareLink {
  id        String   @id @default(uuid()) @db.Uuid
  noteId    String   @unique @map("note_id") @db.Uuid
  token     String   @unique
  viewCount Int      @default(0) @map("view_count")
  createdAt DateTime @default(now()) @map("created_at")

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@map("share_links")
}
