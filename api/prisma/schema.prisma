generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  name            String
  passwordHash    String    @map("password_hash")
  /// Carried in every login token. Bumping it ends all sessions at once.
  tokenVersion    Int       @default(0) @map("token_version")
  /// Choices that follow the user from one device to the next. The shape is
  /// checked in auth/preferences.ts, on the way in and on the way out.
  preferences     Json      @default("{}")
  /// The secret of the authenticator app, encrypted with TWO_STEP_KEY (see
  /// auth/two-step-crypto.ts). Set while codes are being set up, and only
  /// asked for once twoStepSince is set too.
  twoStepSecret   String?   @map("two_step_secret")
  /// When codes were turned on. Null while they are off.
  twoStepSince    DateTime? @map("two_step_since")
  /// The 30-second step of the last code that was taken, so that no code works twice.
  twoStepLastStep Int?      @map("two_step_last_step")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  notebooks      Notebook[]
  notes          Note[]
  tags           Tag[]
  passwordResets PasswordReset[]
  apiTokens      ApiToken[]
  memberships    NotebookMember[]
  invitesSent    NotebookInvite[]
  inviteSends    InviteSend[]
  attachments    Attachment[]
  recoveryCodes  RecoveryCode[]
  emailChanges   EmailChange[]

  @@map("users")
}

/// A recovery code for two-step sign-in. Shown once when made, kept only as a
/// SHA-256 hash, and deleted when used.
model RecoveryCode {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// SHA-256 of the code as typed without dashes, in hex.
  codeHash  String   @unique @map("code_hash")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

/// A new email address that waits for its link to be opened. One per
/// account at a time, under the rules of a password reset link: only a hash
/// of the token, used once, for an hour.
model EmailChange {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  newEmail  String   @map("new_email")
  /// SHA-256 of the token, in hex.
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_changes")
}

/// A long-lived credential for scripts, made and revoked in Settings and sent
/// as "Authorization: Bearer nt_...". Only a hash of the token is kept, so it
/// can be shown exactly once, when it is made.
model ApiToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  name       String
  /// SHA-256 of the token, in hex.
  tokenHash  String    @unique @map("token_hash")
  /// A read-only token is refused on everything but GET.
  readOnly   Boolean   @default(false) @map("read_only")
  /// Written at most once a minute, so reading with a token does not turn
  /// every request into a write.
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_tokens")
}

/// A "forgot password" link that was mailed out. Only a hash of the token in
/// the link is kept, so reading this table does not let anyone reset a
/// password. A row is deleted when its link is used.
model PasswordReset {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// SHA-256 of the token, in hex.
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

/// Notebooks nest up to four levels deep (MAX_NOTEBOOK_DEPTH): a notebook
/// has no parent or a parent at most three levels down. The service enforces
/// this and keeps loops out, under a lock on the user's row.
model Notebook {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Notebook?        @relation("NotebookChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children Notebook[]       @relation("NotebookChildren")
  notes    Note[]
  share    ShareLink?
  members  NotebookMember[]
  invites  NotebookInvite[]

  @@index([userId])
  @@index([parentId])
  @@map("notebooks")
}

/// What a member of a shared notebook may do: read its notes, or also edit them.
enum MemberRole {
  read
  edit

  @@map("member_role")
}

/// Another account that has the notebook, and the notebooks inside it, shared with it.
model NotebookMember {
  notebookId String     @map("notebook_id") @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  role       MemberRole
  createdAt  DateTime   @default(now()) @map("created_at")

  notebook Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notebookId, userId])
  @@index([userId])
  @@map("notebook_members")
}

/// An invitation to a notebook, sent to an address. Accepted in the app by the
/// account with that address, or through the link in the mail.
model NotebookInvite {
  id          String     @id @default(uuid()) @db.Uuid
  notebookId  String     @map("notebook_id") @db.Uuid
  /// Lower case, as accounts are looked up.
  email       String
  role        MemberRole
  /// SHA-256 of the token in the mailed link, in hex. The token itself is never stored.
  tokenHash   String     @unique @map("token_hash")
  invitedById String     @map("invited_by_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at")
  expiresAt   DateTime   @map("expires_at")

  notebook  Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  invitedBy User     @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([notebookId, email])
  @@index([email])
  @@map("notebook_invites")
}

model Note {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  notebookId    String?   @map("notebook_id") @db.Uuid
  title         String
  content       String    @default("")
  pinned        Boolean   @default(false)
  favorite      Boolean   @default(false)
  /// A template is a note that new notes are made from. It is kept out of
  /// the lists, the search and the backlinks (see notes/note-scope.ts).
  isTemplate    Boolean   @default(false) @map("is_template")
  /// Set on the daily note of that day. With the unique index below, a user
  /// has at most one note per day, however many tabs ask for it at once.
  dailyDate     DateTime? @map("daily_date") @db.Date
  /// Set when the user said this note is not the note of its day. "Today"
  /// then no longer takes it for that day because of its title.
  dailyReleased Boolean   @default(false) @map("daily_released")
  /// Set when the note is moved to the trash.
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  /// Only bumped when the title, content, notebook or tags change, so
  /// pinning a note does not move it to the top of "recently edited".
  updatedAt     DateTime  @default(now()) @map("updated_at")
  /// Goes up by one with every change to the title or the content, and with
  /// nothing else. A trigger does the counting (see the note_revision
  /// migration), so no write can forget it. Saves say which revision they
  /// were based on, which is how an edit made somewhere else is noticed.
  revision      Int       @default(0)

  /// Kept up to date by a trigger (see the search migration), queried with raw SQL.
  searchVector Unsupported("tsvector")? @map("search_vector")

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  notebook      Notebook?     @relation(fields: [notebookId], references: [id], onDelete: SetNull)
  tags          NoteTag[]
  outgoingLinks NoteLink[]
  versions      NoteVersion[]
  share         ShareLink?
  attachments   Attachment[]
  tasks         NoteTask[]
  tasksRead     NoteTaskRead?

  @@unique([userId, dailyDate])
  @@index([userId, deletedAt, updatedAt])
  @@index([searchVector], type: Gin)
  @@index([notebookId])
  @@map("notes")
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes NoteTag[]

  @@unique([userId, name])
  @@map("tags")
}

model NoteTag {
  noteId String @map("note_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@index([tagId])
  @@map("note_tags")
}

/// A [[wiki link]] written in a note. Links point at a title rather than an
/// id, so they resolve to whichever note currently has that title.
model NoteLink {
  id          String @id @default(uuid()) @db.Uuid
  sourceId    String @map("source_id") @db.Uuid
  /// The title as written in the link.
  targetTitle String @map("target_title")
  /// Lower-cased, whitespace-collapsed title used for matching.
  targetKey   String @map("target_key")

  source Note @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetKey])
  @@index([targetKey])
  @@map("note_links")
}

model NoteVersion {
  id        String   @id @default(uuid()) @db.Uuid
  noteId    String   @map("note_id") @db.Uuid
  title     String
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, createdAt])
  @@map("note_versions")
}

/// A public, read-only link to one note or to one notebook with everything
/// in it. Exactly one of noteId and notebookId is set, which a check
/// constraint in the migration enforces: Prisma cannot express it here.
model ShareLink {
  id           String    @id @default(uuid()) @db.Uuid
  noteId       String?   @unique @map("note_id") @db.Uuid
  notebookId   String?   @unique @map("notebook_id") @db.Uuid
  token        String    @unique
  viewCount    Int       @default(0) @map("view_count")
  /// From this moment on the link answers like one that does not exist.
  expiresAt    DateTime? @map("expires_at")
  /// Set when readers have to give a password. Hashed like account passwords.
  passwordHash String?   @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")

  note     Note?     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  notebook Notebook? @relation(fields: [notebookId], references: [id], onDelete: Cascade)

  @@map("share_links")
}

/// A file that belongs to a note: a pasted image or an attached PDF. The
/// bytes are in ATTACHMENTS_DIR under the attachment's id, never under a
/// name a user chose. The row goes with its note; the file is removed by
/// the code that deletes notes, and a sweep removes any file left without
/// a row.
model Attachment {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  noteId      String   @map("note_id") @db.Uuid
  /// The name it was uploaded with, for the download and the alt text only.
  fileName    String   @map("file_name")
  /// Decided from the bytes, not from what the upload claimed.
  contentType String   @map("content_type")
  size        Int
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@index([userId])
  @@map("attachments")
}

/// One invitation sent, kept for the limits on sending: per inviting account
/// an hour and per address a day. Rows are only ever added, and pruned once
/// they are older than a day, so withdrawing or renewing an invitation does
/// not make room for more mail.
model InviteSend {
  id          String   @id @default(uuid()) @db.Uuid
  invitedById String   @map("invited_by_id") @db.Uuid
  /// Lower case, as the invitation has it.
  email       String
  sentAt      DateTime @default(now()) @map("sent_at")

  invitedBy User @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([invitedById, sentAt])
  @@index([email, sentAt])
  @@map("invite_sends")
}

/// A task list item of a note, `- [ ]` or `- [x]`, as the parser read it.
/// Read again whenever the Tasks page finds that the note has moved past
/// the revision in NoteTaskRead (see tasks/tasks.service.ts).
model NoteTask {
  id     String  @id @default(uuid()) @db.Uuid
  noteId String  @map("note_id") @db.Uuid
  /// The line of the note the item starts on, counted from 1.
  line   Int
  text   String
  done   Boolean

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@map("note_tasks")
}

/// Which revision of a note its tasks were read from, and whether the
/// parser could read it at all. A note without a row has not been read yet.
model NoteTaskRead {
  noteId   String  @id @map("note_id") @db.Uuid
  revision Int
  readable Boolean

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@map("note_task_reads")
}
