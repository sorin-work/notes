# Copy to .env for running the API outside Docker.
DATABASE_URL=postgresql://notes:notes@localhost:5441/notes
JWT_SECRET=local-development-secret-change-me-0123456789
PORT=4401
LOG_LEVEL=debug
SEED_DEMO=true

# Password reset needs an SMTP server. Without SMTP_HOST mail is off and the
# sign-in page does not offer "Forgot password?". With it, SMTP_FROM and
# APP_URL are required, and so is TLS unless SMTP_REQUIRE_TLS=false (a local
# test server such as mailpit has none).
#SMTP_HOST=localhost
#SMTP_PORT=1025
#SMTP_FROM=Notes <notes@localhost>
#SMTP_REQUIRE_TLS=false
#APP_URL=http://localhost:5181
