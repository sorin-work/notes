# Copy to .env and adjust. docker compose reads .env from the repo root.

# Host ports
DB_PORT=5441
API_PORT=4401
WEB_PORT=5181

# Signs login tokens. Use a long random string outside local development.
JWT_SECRET=local-development-secret-change-me-0123456789

# debug, info, warn or error
LOG_LEVEL=info

# Days a note stays in the trash before it is deleted for good.
TRASH_RETENTION_DAYS=30

# Create demo@example.com / demo-password with sample notes on first start.
SEED_DEMO=true

# Daily database dumps. Uncomment to start the backup service together with
# the rest on every "docker compose up".
#COMPOSE_PROFILES=backup

# Folder on this machine the dumps are written to, and how many are kept.
BACKUP_DIR=./backups
BACKUP_KEEP=7

# Seconds from one dump to the next. One day.
BACKUP_INTERVAL_SECONDS=86400
