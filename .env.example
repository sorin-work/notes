# Copy to .env and adjust. docker compose reads .env from the repo root.

# Host ports
DB_PORT=5441
API_PORT=4401
WEB_PORT=5181

# Signs login tokens. Use a long random string outside local development.
JWT_SECRET=local-development-secret-change-me-0123456789

# debug, info, warn or error
LOG_LEVEL=info

# Days a note stays in the trash before it is deleted for good.
TRASH_RETENTION_DAYS=30

# Create demo@example.com / demo-password with sample notes on first start.
SEED_DEMO=true

# Mail, which the API uses for password reset links. Left alone, it goes to
# the mailpit container: read it at http://localhost:8041, nothing is
# delivered. For real mail, point these at an SMTP server. "SMTP_HOST=" with
# nothing after it switches mail and password reset off.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_FROM=Notes <notes@example.com>
#SMTP_USER=
#SMTP_PASSWORD=
# With an SMTP_HOST of your own, mail is only sent over TLS: from the start
# on port 465, through STARTTLS on any other port. "false" allows it in the
# clear, which is only for a test server on a network you trust.
#SMTP_REQUIRE_TLS=true
MAILPIT_UI_PORT=8041

# Where people reach the web app. The links in mails start with this.
APP_URL=http://localhost:5181

# Reverse proxies in front of the API, so that the limits on logins and the
# like count per visitor. 1 is nginx in the web container. Use 0 if people
# can reach the API port directly: they could then name any address they like.
TRUST_PROXY=1

# Daily database dumps. Uncomment to start the backup service together with
# the rest on every "docker compose up".
#COMPOSE_PROFILES=backup

# Folder on this machine the dumps are written to, and how many are kept.
BACKUP_DIR=./backups
BACKUP_KEEP=7

# Seconds from one dump to the next. One day.
BACKUP_INTERVAL_SECONDS=86400
